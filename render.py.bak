MINI_STAT_FONT = ImageFont.truetype(str(FONT_DIR / "Inter.ttf"), 13)
MAP_FONT = ImageFont.truetype(str(FONT_DIR / "Inter.ttf"), 12)
LIST_FONT = ImageFont.truetype(str(FONT_DIR / "Inter.ttf"), 11)

